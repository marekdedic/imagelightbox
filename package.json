{
  "name": "imagelightbox",
  "version": "4.0.0",
  "description": "Image Lightbox, Responsive and Touch‑friendly",
  "keywords": [
    "jquery",
    "lightbox"
  ],
  "homepage": "https://marekdedic.github.io/imagelightbox",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marekdedic/imagelightbox.git"
  },
  "license": "MIT",
  "author": {
    "name": "Marek Dědič",
    "email": "developer@dedic.eu",
    "url": "https://dedic.eu/"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "style": "./dist/imagelightbox.css",
        "types": "./dist/imagelightbox.d.ts",
        "default": "./dist/imagelightbox.js"
      },
      "require": {
        "style": "./dist/imagelightbox.css",
        "types": "./dist/imagelightbox.d.cts",
        "default": "./dist/imagelightbox.umd.cjs"
      }
    },
    "./jquery": {
      "import": {
        "style": "./dist/imagelightbox.css",
        "types": "./dist/imagelightbox.jquery.d.ts",
        "default": "./dist/imagelightbox.jquery.js"
      },
      "require": {
        "style": "./dist/imagelightbox.css",
        "types": "./dist/imagelightbox.jquery.d.cts",
        "default": "./dist/imagelightbox.jquery.umd.cjs"
      }
    }
  },
  "main": "./dist/imagelightbox.umd.cjs",
  "types": "./dist/imagelightbox.d.ts",
  "module": "./dist/imagelightbox.js",
  "style": "./dist/imagelightbox.css",
  "sideEffects": true,
  "files": [
    "dist",
    "!dist/webpack-stats.jquery.json",
    "!dist/webpack-stats.native.json",
    "jquery",
    "types"
  ],
  "scripts": {
    "prebuild": "npm run clean",
    "build": "run-p -c --aggregate-output build:docs build:lib",
    "build:docs": "vite build --config docs.vite.config.ts",
    "build:lib": "run-s build:lib:jquery build:lib:native build:lib:cjs-types",
    "build:lib:cjs-types": "cp dist/imagelightbox.d.ts dist/imagelightbox.d.cts && cp dist/imagelightbox.jquery.d.ts dist/imagelightbox.jquery.d.cts",
    "build:lib:jquery": "vite build --config jquery.vite.config.ts && mv dist/imagelightbox.d.ts dist/imagelightbox.jquery.d.ts",
    "build:lib:native": "vite build --config native.vite.config.ts",
    "check": "run-p -c --aggregate-output check:*",
    "check:css-compat": "node scripts/check-css-compat.js",
    "check:js-compat": "es-check es2017 --module --checkFeatures 'dist/*.js' && es-check es2017 'dist/*.cjs'",
    "clean": "rimraf dist/* docs/*",
    "lint": "run-p -c --aggregate-output lint:*",
    "lint:css": "run-p -c --aggregate-output lint:css:*",
    "lint:css:stylelint": "stylelint --color --report-needless-disables 'src/**/*.css'",
    "lint:eslint": "eslint --color",
    "lint:ts": "run-p -c --aggregate-output lint:ts:*",
    "lint:ts:attw": "attw --pack",
    "lint:ts:typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "playwright-interactive": "playwright test --ui",
    "start": "vite --config docs.vite.config.ts",
    "test": "nyc --reporter=lcov playwright test"
  },
  "browserslist": [
    "baseline 2019",
    "not edge 18"
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.4.0",
    "@eslint/css": "^1.0.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.0",
    "@eslint/markdown": "^8.0.0",
    "@microsoft/api-extractor": "^7.58.13",
    "@playwright/test": "^1.47.0",
    "@types/jquery": "^4.0.1",
    "@types/node": "^26.0.0",
    "browserslist": "^4.28.8",
    "doiuse": "^6.0.6",
    "es-check": "^9.6.4",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-compat": "^7.0.0",
    "eslint-plugin-package-json": "^1.0.0",
    "eslint-plugin-perfectionist": "^5.0.0",
    "eslint-plugin-playwright": "^2.0.0",
    "eslint-plugin-prefer-arrow-functions": "^3.4.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^17.0.0",
    "jquery": ">=1.12.4 <5.0.0",
    "lightningcss": "^1.33.0",
    "npm-run-all": "^4.1.5",
    "nyc": "^18.0.0",
    "playwright": "^1.47.0",
    "playwright-test-coverage": "^1.2.12",
    "postcss": "^8.5.26",
    "prettier": "^3.0.0",
    "rimraf": "^6.0.1",
    "rollup-plugin-webpack-stats": "^4.0.0",
    "stylelint": "^17.1.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-prettier": "^5.0.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "unplugin-dts": "^1.0.3",
    "vite": "^8.0.8",
    "vite-plugin-istanbul": "^9.0.1"
  }
}
